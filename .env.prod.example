# Copy into the GitHub secret PROD_ENV (one value, full file content). Never commit real values.
DATABASE_URL=postgresql://mquora:CHANGE_ME@postgres:5432/mquora?connection_limit=20&pool_timeout=10
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_chars
NEXTAUTH_SECRET=CHANGE_ME_64_chars

# Public URLs (NEXT_PUBLIC_API_URL is also set as the repo variable of the same name for the web build)
NEXTAUTH_URL=https://mquora.example.com
NEXT_PUBLIC_API_URL=https://mquora.example.com/api/v1
ALLOWED_ORIGINS=https://mquora.example.com

AI_GATEWAY_URL=

POSTGRES_DB=mquora
POSTGRES_USER=mquora
POSTGRES_PASSWORD=CHANGE_ME
