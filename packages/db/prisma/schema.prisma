generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  USER
  TRUSTED_CONTRIBUTOR
  COMMUNITY_MODERATOR
  VERIFIED_EXPERT
  ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REMOVED
  DELETED
}

enum AdminNotifType {
  USER_REGISTRATION
  NEW_QUESTION
  COMMAND
  CONTENT_REPORT
}

enum VoteType {
  UP
  DOWN
}

enum AnswerVoteType {
  UP
  DOWN
}

enum ModerationAction {
  WARN
  REMOVE
  RESTRICT
  BAN
  DISMISS
}

enum Language {
  MALAYALAM
  ENGLISH
  MANGLISH
  MIXED
}

enum NotifType {
  VOTE
  ANSWER
  COMMENT
  FOLLOW
  MENTION
  MODERATION
  SYSTEM
}

enum ReputationEventType {
  POST_UPVOTED
  POST_DOWNVOTED
  ANSWER_UPVOTED
  ANSWER_DOWNVOTED
  ANSWER_ACCEPTED
  COMMENT_UPVOTED
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
}

model User {
  pushTokens         PushToken[]
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String?
  displayName           String
  username              String          @unique
  role                  UserRole        @default(USER)
  reputationScore       Int             @default(0)
  isVerified            Boolean         @default(false)
  isApproved            Boolean         @default(false)
  digestOptIn           Boolean         @default(false)
  bannedAt              DateTime?
  bannedUntil           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  profile               UserProfile?
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  identities            Identity[]
  posts                 Post[]
  answers               Answer[]
  comments              Comment[]
  votes                 Vote[]
  bookmarks             Bookmark[]
  followers             Follow[]        @relation("followers")
  following             Follow[]        @relation("following")
  notifications         Notification[]
  pushSubscriptions     NotificationSubscription[]
  reputationEvents      ReputationEvent[]
  badges                UserBadge[]
  reports               Report[]        @relation("reporter")
  resolvedReports       Report[]        @relation("resolver")
  moderationLogs        ModerationLog[]
  auditLogs             AuditLog[]      @relation("actor")
  mediaAssets           MediaAsset[]
  communitiesCreated    Community[]     @relation("creator")
  communityMemberships  CommunityMember[]
  communityInvitesCreated CommunityInvite[] @relation("community_invites")
  questionVisits    QuestionVisit[]
  tagFollows            TagFollow[]
  questionFollows       QuestionFollow[]
  questionPasses        QuestionPass[]
  answerRequestsSent    AnswerRequest[] @relation("requester")
  answerRequestsReceived AnswerRequest[] @relation("requestee")
  answerVotes           AnswerVote[]    @relation("user_answer_votes")
  subscriptions         QuestionSubscription[] @relation("subscriptions")
  onboardedAt           DateTime?

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
}

model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  bio               String?
  avatarUrl         String?
  location          String?
  website           String?
  credential        String?
  socialLinks       Json?     @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Identity {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerUserId    String    @unique
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Community {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  description       String?
  iconUrl           String?
  bannerUrl         String?
  isPublic          Boolean   @default(true)
  memberCount       Int       @default(0)
  postCount         Int       @default(0)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  creator           User      @relation("creator", fields: [createdBy], references: [id])
  members           CommunityMember[]
  posts             Post[]
  invites           CommunityInvite[]

  @@index([slug])
  @@index([createdBy])
  @@index([deletedAt])
  @@index([createdAt])
}

model CommunityMember {
  id                String    @id @default(cuid())
  communityId       String
  userId            String
  role              String    @default("MEMBER")
  joinedAt          DateTime  @default(now())

  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model AnswerRevision {
  id        String   @id @default(cuid())
  answerId  String
  body      String
  createdAt DateTime @default(now())

  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId, createdAt])
}

model QuestionVisit {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  visitedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, visitedAt])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([createdAt])
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  token       String    @unique
  createdBy   String
  expiresAt   DateTime
  uses        Int       @default(0)
  maxUses     Int?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation("community_invites", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([communityId])
}

model Post {
  id                String    @id @default(cuid())
  authorId          String
  communityId       String?
  title             String
  body              String
  type              String    @default("QUESTION")
  language          Language  @default(ENGLISH)
  originalText      String
  normalizedText    String?
  isManglish        Boolean   @default(false)
  status            ContentStatus @default(PUBLISHED)
  voteScore         Int       @default(0)
  answerCount       Int       @default(0)
  commentCount      Int       @default(0)
  viewCount         Int       @default(0)
  seoSlug           String    @unique
  seoTitle          String?
  seoDesc           String?
  acceptedAnswerId  String?
  followerCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  author            User      @relation(fields: [authorId], references: [id])
  community         Community? @relation(fields: [communityId], references: [id])
  followers         QuestionFollow[]
  passes            QuestionPass[]
  answerRequests    AnswerRequest[]
  subscribers       QuestionSubscription[] @relation("subscribers")
  answers           Answer[]
  comments          Comment[]
  votes             Vote[]    @relation("post")
  bookmarks         Bookmark[]
  tags              PostTag[]
  reports           Report[]  @relation("report_post")
  embedding         PostEmbedding?
  sourceOf          DuplicateCandidate[] @relation("source")
  targetOf          DuplicateCandidate[] @relation("target")

  views             PostView[]
  questionVisits    QuestionVisit[]

  @@index([authorId])
  @@index([communityId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([seoSlug])
}

model Answer {
  id                String    @id @default(cuid())
  postId            String
  authorId          String
  body              String
  language          Language  @default(ENGLISH)
  originalText      String
  normalizedText    String?
  isManglish        Boolean   @default(false)
  status            ContentStatus @default(PUBLISHED)
  voteScore         Int       @default(0)
  voteCount         Int            @default(0)
  viewCount         Int            @default(0)
  commentCount      Int       @default(0)
  isAccepted        Boolean   @default(false)
  isPinned          Boolean   @default(false)
  qualityScore      Int?
  editedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author            User      @relation(fields: [authorId], references: [id])
  comments          Comment[]
  revisions         AnswerRevision[]
  votes             Vote[]    @relation("answer")
  answerVotes       AnswerVote[] @relation("answer_votes")
  reports           Report[]  @relation("report_answer")
  embedding         AnswerEmbedding?

  @@index([postId])
  @@index([authorId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
}

model Comment {
  id                String    @id @default(cuid())
  parentId          String?
  postId            String?
  answerId          String?
  authorId          String
  body              String
  status            ContentStatus @default(PUBLISHED)
  voteScore         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  parent            Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           Comment[] @relation("replies")
  post              Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  answer            Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  author            User      @relation(fields: [authorId], references: [id])
  votes             Vote[]    @relation("comment")
  reports           Report[]  @relation("report_comment")

  @@index([parentId])
  @@index([postId])
  @@index([answerId])
  @@index([authorId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
}

model Vote {
  id                String    @id @default(cuid())
  authorId          String
  targetId          String
  targetType        String
  type              VoteType
  createdAt         DateTime  @default(now())

  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post              Post?     @relation("post", fields: [targetId], references: [id], onDelete: Cascade, map: "Vote_post_fkey")
  answer            Answer?   @relation("answer", fields: [targetId], references: [id], onDelete: Cascade, map: "Vote_answer_fkey")
  comment           Comment?  @relation("comment", fields: [targetId], references: [id], onDelete: Cascade, map: "Vote_comment_fkey")

  @@unique([authorId, targetId, targetType])
  @@index([authorId])
  @@index([targetId])
  @@index([targetType])
}

model AnswerVote {
  id                String    @id @default(cuid())
  answerId          String
  userId            String
  type              AnswerVoteType
  createdAt         DateTime  @default(now())

  answer            Answer    @relation("answer_votes", fields: [answerId], references: [id], onDelete: Cascade)
  user              User      @relation("user_answer_votes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@index([answerId])
  @@index([userId])
}



model Bookmark {
  id                String    @id @default(cuid())
  userId            String
  postId            String
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Follow {
  id                String    @id @default(cuid())
  followerId        String
  followingId       String
  createdAt         DateTime  @default(now())

  follower          User      @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following         User      @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Tag {
  id                String    @id @default(cuid())
  name              String    @unique
  slug              String    @unique
  postCount         Int       @default(0)
  createdAt         DateTime  @default(now())

  posts             PostTag[]
  followers         TagFollow[]

  @@index([slug])
}

// User follows a topic (tag) — feeds "Following" and "Questions for you".
model TagFollow {
  id                String    @id @default(cuid())
  userId            String
  tagId             String
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag               Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
}

// User follows a question — notified on new answers.
model QuestionFollow {
  id                String    @id @default(cuid())
  userId            String
  postId            String
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// User subscribes to a question — gets web push notifications on new answers.
model QuestionSubscription {
  id                String    @id @default(cuid())
  userId            String
  postId            String
  createdAt         DateTime  @default(now())

  user              User      @relation("subscriptions", fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation("subscribers", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

// User hid a question from "Questions for you".
model QuestionPass {
  id                String    @id @default(cuid())
  userId            String
  postId            String
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model PostTag {
  id                String    @id @default(cuid())
  postId            String
  tagId             String
  createdAt         DateTime  @default(now())

  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag               Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              NotifType
  title             String
  body              String
  link              String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model ReputationEvent {
  id                String              @id @default(cuid())
  userId            String
  event             ReputationEventType
  delta             Int
  sourceId          String?
  createdAt         DateTime            @default(now())

  user              User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Badge {
  id                String    @id @default(cuid())
  name              String    @unique
  description       String?
  type              String    @default("CONTENT")
  createdAt         DateTime  @default(now())

  users             UserBadge[]

  @@index([name])
}

model UserBadge {
  id                String    @id @default(cuid())
  userId            String
  badgeId           String
  awardedAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge             Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Report {
  id                String        @id @default(cuid())
  reporterId        String
  targetId          String
  targetType        String
  reason            String
  details           String?
  status            ReportStatus  @default(PENDING)
  resolvedBy        String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reporter          User          @relation("reporter", fields: [reporterId], references: [id])
  resolver          User?         @relation("resolver", fields: [resolvedBy], references: [id])
  post              Post?         @relation("report_post", fields: [targetId], references: [id], onDelete: Cascade, map: "Report_post_fkey")
  answer            Answer?       @relation("report_answer", fields: [targetId], references: [id], onDelete: Cascade, map: "Report_answer_fkey")
  comment           Comment?      @relation("report_comment", fields: [targetId], references: [id], onDelete: Cascade, map: "Report_comment_fkey")
  moderationLogs    ModerationLog[]

  @@index([reporterId])
  @@index([targetId])
  @@index([targetType])
  @@index([status])
  @@index([resolvedBy])
}

model ModerationLog {
  id                String              @id @default(cuid())
  moderatorId       String
  reportId          String
  action            ModerationAction
  notes             String?
  createdAt         DateTime            @default(now())

  moderator         User                @relation(fields: [moderatorId], references: [id])
  report            Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([moderatorId])
  @@index([reportId])
  @@index([createdAt])
}

model AuditLog {
  id                String    @id @default(cuid())
  actorId           String?
  action            String
  targetId          String?
  targetType        String?
  metadata          Json?     @default("{}")
  ipAddress         String?
  createdAt         DateTime  @default(now())

  actor             User?     @relation("actor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

model MediaAsset {
  id                String    @id @default(cuid())
  uploaderId        String
  url               String
  storageKey        String    @unique
  mimeType          String
  sizeBytes         BigInt
  createdAt         DateTime  @default(now())

  uploader          User      @relation(fields: [uploaderId], references: [id])

  @@index([uploaderId])
}

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  enabled           Boolean   @default(false)
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([key])
  @@index([enabled])
}

model SystemSetting {
  id                String    @id @default(cuid())
  key               String    @unique
  value             Json
  updatedAt         DateTime  @updatedAt

  @@index([key])
}

model PostEmbedding {
  id                String    @id @default(cuid())
  postId            String    @unique
  embedding         Unsupported("vector(768)")?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model AnswerEmbedding {
  id                String    @id @default(cuid())
  answerId          String    @unique
  embedding         Unsupported("vector(768)")?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  answer            Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
}

model DuplicateCandidate {
  id                String    @id @default(cuid())
  sourcePostId      String
  targetPostId      String
  score             Float
  status            String    @default("PENDING")
  reportedBy        String?
  createdAt         DateTime  @default(now())

  sourcePost        Post      @relation("source", fields: [sourcePostId], references: [id], onDelete: Cascade)
  targetPost        Post      @relation("target", fields: [targetPostId], references: [id], onDelete: Cascade)

  @@unique([sourcePostId, targetPostId])
  @@index([sourcePostId])
  @@index([targetPostId])
  @@index([status])
}

model AdminNotification {
  id                String          @id @default(cuid())
  type              AdminNotifType
  title             String
  body              String
  link              String?
  isRead            Boolean         @default(false)
  relatedUserId     String?
  relatedPostId     String?
  createdAt         DateTime        @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

model NotificationSubscription {
  id                String    @id @default(cuid())
  userId            String
  endpoint          String    @unique
  p256dh            String
  auth              String
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([isActive])
}

// User requests a specific person to answer a question.
model AnswerRequest {
  id            String    @id @default(cuid())
  postId        String
  requesterId   String
  requesteeId   String
  message       String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  requester     User      @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  requestee     User      @relation("requestee", fields: [requesteeId], references: [id], onDelete: Cascade)

  @@unique([postId, requesterId, requesteeId])
  @@index([postId])
  @@index([requesteeId])
  @@index([requesterId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
