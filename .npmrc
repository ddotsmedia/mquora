# Expo / React Native packages are resolved by tooling from apps/mobile without declaring them
# (expo-modules-core, expo-asset, query-string, ...). Hoist them so pnpm exposes them.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=query-string
