{
  "name": "mquora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Malayalam-first knowledge & community platform",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @mquora/api dev\" \"pnpm --filter @mquora/worker dev\" \"pnpm --filter @mquora/web dev\"",
    "build": "pnpm --recursive run build",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "pnpm --recursive run test",
    "docker:dev": "docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @mquora/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @mquora/db exec prisma db seed",
    "db:studio": "pnpm --filter @mquora/db exec prisma studio"
  },
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
