{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "../../",
    "module": "commonjs",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node10",
    "lib": ["ES2020"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@worker/*": ["./apps/worker/src/*"],
      "@ai": ["./packages/ai/src"],
      "@ai/*": ["./packages/ai/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
