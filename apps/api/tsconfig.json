{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../../",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@api/*": ["./apps/api/src/*"],
      "@ai": ["./packages/ai/src"],
      "@ai/*": ["./packages/ai/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "test/**/*"]
}
